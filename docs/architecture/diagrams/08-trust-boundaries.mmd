flowchart LR
  classDef impl fill:#E7F1EC,stroke:#2F5D50,stroke-width:1.5px,color:#14201B
  classDef existing fill:#FFFFFF,stroke:#8A8F98,stroke-width:1.2px,color:#15171B
  classDef external fill:#FBF3E4,stroke:#A9762C,stroke-width:1.4px,color:#3A2A10
  classDef blocked fill:#F7ECEA,stroke:#A6584C,stroke-width:1.2px,stroke-dasharray:2 3,color:#3B1D18
  classDef secret fill:#15171B,stroke:#15171B,stroke-width:1px,color:#FFFFFF

  subgraph Z0["Zone 0 · browser · untrusted"]
    ANY["Signed out · ordinary account<br/>disabled account · another admin's ids"]:::existing
    ADMINBROWSER["Admin browser<br/>no key · no provider file ids · no connection strings"]:::impl
  end

  subgraph Z1["Zone 1 · RichHabit server · trusted"]
    direction TB
    ROUTES["workspace routes · P2"]:::impl
    GUARD["workspaceAdmin → currentAdmin<br/>role re-read every request · 404"]:::existing
    RUNTIME["runtime · P2<br/>context from five layers only · logs codes only"]:::impl
    DATA["queries.ts · P1<br/>user_id on every statement"]:::impl
    SECRET["CLAUDE_API_KEY<br/>read in env.ts · used in claude.ts"]:::secret
    ANALYTICS["analytics · trackEvent"]:::blocked
  end

  subgraph Z2["Zone 2 · Neon Postgres · trusted storage"]
    AITABLES[("7 ai_ tables<br/>no credentials stored")]:::impl
    PERSONAL[("intentions · habits · priorities<br/>gratitude journal · dates · Community")]:::blocked
  end

  subgraph Z3["Zone 3 · Anthropic · third party"]
    ANTHROPIC["receives workspace and project instructions,<br/>chosen history, attached files, the message"]:::external
  end

  ANY -->|"any workspace route → 404"| GUARD
  ADMINBROWSER -->|"HTTPS · SameSite session cookie"| ROUTES
  ROUTES --> GUARD --> RUNTIME --> DATA
  DATA ==>|"owner-scoped SQL"| AITABLES
  RUNTIME -->|"server to server · streaming"| ANTHROPIC
  SECRET -.->|"never sent to the browser"| ANTHROPIC
  RUNTIME -. "no import path · boundary tests" .-> PERSONAL
  RUNTIME -. "never called · boundary tests" .-> ANALYTICS
