# Render Postgres. Copy the External Connection String from the Render
# dashboard (Internal if the app runs inside Render). Server-side only —
# nothing here is exposed to the browser.
DATABASE_URL=postgresql://user:password@host.oregon-postgres.render.com/richhabits

# Optional. Connections in the pool, default 10. Lower it if you run several
# instances against a plan with a small connection limit.
PG_POOL_MAX=

# Optional. Only needed for the AI coach at /api/coach.
OPENAI_API_KEY=

# Optional. Defaults to gpt-5.6-terra.
OPENAI_MODEL=
