# =============================================================================
# Rich Habits — environment
#
# Copy to .env.local and fill in. Everything here is SERVER-ONLY: there is not a
# single NEXT_PUBLIC_* variable in this project, because the browser needs no
# configuration — it only ever calls same-origin /api routes. If you ever add
# one, remember NEXT_PUBLIC_* is inlined into the JavaScript bundle and is
# readable by anyone who opens devtools. Never put a secret behind that prefix.
#
# Only DATABASE_URL is required. Everything else has a working default, shown
# as the commented value.
# =============================================================================

# ----------------------------------------------------------------- database --
# REQUIRED. Render: copy the Internal Connection String for a service running
# inside Render, the External one from your laptop.
# Local docker compose: postgresql://richhabits:richhabits@localhost:5432/richhabits
# Local `npm run db:dev`: postgres://postgres@127.0.0.1:5433/postgres
#
# THIS MUST BE A LOCAL DATABASE FOR DEVELOPMENT. `npm run dev` refuses a remote
# one and tells you how to start a local Postgres — because .env.local is read
# by the dev server, and a production connection string sitting in it means a
# click while building a feature edits real people's habits. The deployed app
# is unaffected: the check is skipped when NODE_ENV=production.
#
# Keep production's string in this file too, but COMMENTED OUT, and pass it
# inline when you deliberately mean it:
#   RH_ALLOW_REMOTE=1 DATABASE_URL='postgresql://…' npm run db:deploy
DATABASE_URL=

# TLS is worked out from the hostname: off for localhost and for undotted
# private names (Render's internal host), on for a public FQDN. Set this only
# when that guess is wrong. "disable" | "require"
# DATABASE_SSL=

# Connections in the pool.
# PG_POOL_MAX=10

# How long an idle connection is held, in milliseconds. Worth lowering only
# against a single-connection dev database, where a held connection blocks psql.
# PG_IDLE_MS=30000

# How long to wait for a connection before giving up, in milliseconds.
# PG_CONNECT_TIMEOUT_MS=10000

# --------------------------------------------------------------------- auth --
# How long a sign-in lasts, in days.
# SESSION_TTL_DAYS=30

# Password bounds. The maximum is a denial-of-service guard: scrypt cost grows
# with input length.
# AUTH_MIN_PASSWORD=8
# AUTH_MAX_PASSWORD=200

# Failed sign-ins allowed per email+IP within the window.
# AUTH_MAX_ATTEMPTS=10
# AUTH_ATTEMPT_WINDOW_MINUTES=15

# ----------------------------------------------------------------- AI coach --
# The AI coach and the AI habit recommendations both run on Claude, through the
# same server-only CLAUDE_API_KEY set below under Intention suggestions. There is
# no separate coach credential. Without that key both answer 501 and nothing
# else changes.
#
# The model, overridable without touching code. Separate from
# INTENTION_AI_MODEL because the coach reasons over a whole account's history
# while a suggestion is one short list.
# COACH_MODEL=claude-sonnet-5
# Enough for a few grounded paragraphs, or a short list. Not an essay.
# COACH_MAX_OUTPUT_TOKENS=1200
# COACH_MAX_QUESTION_LENGTH=500
# Serverless timeout for the coach route, in seconds. Reasoning models outlast
# the platform default.
# COACH_TIMEOUT_SECONDS=60

# Per-account safety limit for the coach, counted in the database so it survives
# a deploy and is shared between instances. This is a platform cost guard, not a
# plan feature: it applies to every account, admins included. Raising it costs
# money — the ceiling on one account's spend is hourly × the price of a request.
# COACH_HOURLY_LIMIT=20
# COACH_DAILY_LIMIT=50

# ------------------------------------------- Intention suggestions (Claude) --
# Optional. Suggested habits and priorities in Clarify Your Intention.
# A SECRET, read only on the server: never commit a real value, and never
# prefix it with NEXT_PUBLIC_. Without it, suggestions are unavailable and the
# rest of the feature works normally.
# Create the key inside the Anthropic workspace it should use, so it is scoped
# to that workspace. No workspace id setting is needed or read.
CLAUDE_API_KEY=

# INTENTION_AI_MODEL=claude-sonnet-5
# INTENTION_AI_TIMEOUT_SECONDS=30
# Per-user request limits for suggestions.
# INTENTION_AI_HOURLY_LIMIT=10
# INTENTION_AI_DAILY_LIMIT=30

# ---------------------------------------------- AI Workspace (admin only) ----
# A general-purpose assistant with more than one model. Claude uses
# CLAUDE_API_KEY above. Every AI_WORKSPACE_ value below is a default and
# optional. Limits are configuration, so raising them needs no migration.
# AI_WORKSPACE_MODEL=claude-sonnet-5
#
# SERVER-ONLY secret. Google's Gemini API key. When set, Gemini joins the model
# selector and image generation is turned on; when absent the workspace runs on
# Claude alone. Never prefix it with NEXT_PUBLIC_. Image models need a Google
# project with billing enabled: the free tier allows no image requests.
GEMINI_API_KEY=
# AI_WORKSPACE_GEMINI_MODEL=gemini-3.8-flash
# Nano Banana 2. gemini-3-pro-image (Nano Banana Pro) is the higher-quality option.
# AI_WORKSPACE_IMAGE_MODEL=gemini-3.1-flash-image
# 512px, 1K, 2K or 4K. Generated images count against the storage quota below.
# AI_WORKSPACE_IMAGE_SIZE=1K
#
# AI_WORKSPACE_MAX_OUTPUT_TOKENS=8000
# AI_WORKSPACE_CONTEXT_TARGET_TOKENS=150000
# AI_WORKSPACE_CONTEXT_MAX_TOKENS=200000
# Messages per admin.
# AI_WORKSPACE_HOURLY_LIMIT=20
# AI_WORKSPACE_DAILY_LIMIT=100
# File limits, in MB.
# AI_WORKSPACE_MAX_PDF_MB=10
# AI_WORKSPACE_MAX_IMAGE_MB=5
# AI_WORKSPACE_MAX_TEXT_MB=2
# AI_WORKSPACE_STORAGE_QUOTA_MB=100
# Browser suites only: scripted stand-ins for every model. Honoured solely on a local
# test instance (RH_TEST_INSTANCE=true with a localhost DATABASE_URL, never in
# production). Leave unset everywhere else.
# AI_WORKSPACE_FAKE_PROVIDER=

# ---------------------------------------------------------------- analytics --
# A gap longer than this starts a new session, in minutes.
# ANALYTICS_SESSION_IDLE_MINUTES=30

# Stamped onto every analytics event. Set this in production — npm_package_version
# only exists when the process was started by npm.
# APP_VERSION=0.1.0

# -------------------------------------------------------------------- admin --
# The account the admin scripts act on when you omit the email argument:
#   npm run admin:grant       -> grants admin to ADMIN_EMAIL
#   npm run admin:password    -> sets that account's password (prompts, hidden)
# Not a secret, and not an authorisation check — the role lives in users.role.
ADMIN_EMAIL=

# NOTE: there is deliberately no ADMIN_PASSWORD here. No environment variable
# can act as a credential anywhere in this application; a variable that granted
# access would be a backdoor, and on Render env vars are visible in the
# dashboard and can surface in logs. Set passwords with `npm run admin:password`
# and keep them in a password manager.

# ------------------------------------------------------- early access cap ----
# How many active non-admin accounts may exist. THE DEFAULT IS 0: NO LIMIT, so
# sign-up is open unless you deliberately set a number here.
#
#   unset or 0            no limit; enforcement is skipped entirely
#   a positive whole      enforced at that number — admins are exempt, and a
#   number                disabled or unverified account takes no place
#   anything else         no limit, and one warning naming the value
#
# The last case fails OPEN on purpose: a cap is a restriction, and a typo should
# not close the door on everyone trying to sign up.
#
# This is the one value with its own parser rather than the shared one, because
# it is the only one where 0 is a real setting. Everywhere else 0 is nonsense
# (a pool of 0 connections, a 0-character password) and falls back to a default.
# EARLY_ACCESS_USER_LIMIT=0

# Require NEW registrations to confirm their email address before the account
# becomes active and takes a place (when a limit is set above).
#
# Read once, at sign-up, and stamped onto the account as
# users.verification_required. It is never consulted again — which is what
# leaves every existing account untouched, and means turning this off and on
# cannot retroactively lock anyone out.
#
# Do not turn this on until mail is configured below and a test message has
# actually arrived: with it on and no transport, every new sign-up sits pending
# forever and the only symptom is registrations that never complete.
# REQUIRE_EMAIL_VERIFICATION=false

# How long a confirmation link stays usable, and the minimum gap between two
# confirmation emails to the same account.
# VERIFY_LINK_TTL_HOURS=24
# VERIFY_RESEND_GAP_SECONDS=60

# Forgotten-password links. Shorter-lived than a confirmation link on purpose:
# a reset token is a way into an account that already exists. The two limits are
# per account and database-backed, so a restart cannot reset someone's
# allowance, and a reset is only ever sent to an address that has been verified.
# PASSWORD_RESET_TTL_MINUTES=30
# PASSWORD_RESET_GAP_SECONDS=60
# PASSWORD_RESET_MAX_PER_DAY=5

# ------------------------------------------------------------ outgoing mail ---
# The public origin of this deployment. Confirmation links are built from it.
# Deliberately not inferred from the request Host header, which is attacker-
# controlled and would let a forged header rewrite the link in someone's email.
# On Render, RENDER_EXTERNAL_URL is used when this is unset.
# APP_URL=https://richhabit.onrender.com

# Resend. SECRET — set it in the Render dashboard, never in a committed file.
# RESEND_API_KEY=

# The From header. The domain must be verified in Resend or every send is
# refused. Example: RichHabit <info@rosalytics.com>
# MAIL_FROM=

# Optional, when replies should go somewhere other than the sender.
# MAIL_REPLY_TO=

# Local and test use only. When set, messages are written to this directory as
# JSON instead of being sent, which is how the whole confirmation flow is driven
# end to end without a provider. NEVER set this in production — it would mean
# nothing is ever actually delivered.
# MAIL_OUTBOX_DIR=.mail-outbox

# ---------------------------------------------------------------- tooling ----
# NEVER set this in production. It marks every account the server creates as
# created_via='test', which is how Admin -> Users tells fixtures from real
# people. `npm run dev:test` sets it for the throwaway stack on port 3002.
# RH_TEST_INSTANCE=false

# Port for `npm run db:dev`, the WASM Postgres used when Docker is unavailable.
# DEV_DB_PORT=5433

# Build output directory. Set this to build without disturbing a running
# `npm run dev`, which owns .next:  NEXT_DIST_DIR=.next-build npm run build
# NEXT_DIST_DIR=.next

# Product thresholds — engagement bands, the activation rule, retention
# checkpoints — are NOT environment variables. They live in
# src/lib/analytics/config.ts so they go through code review and show up in git
# history, rather than differing silently between deployments.
